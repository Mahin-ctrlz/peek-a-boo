{
  "manifest_version": 3,
  "name": "Peek — Results can wait",
  "version": "1.1.0",
  "description": "Hides your UCAM results behind a calm little overlay until you're ready to look, with a built-in CGPA what-if calculator, target-grade helper, and trend chart. Nothing is uploaded, changed, or tracked — it all happens on your screen.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Peek"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ucam.uap-bd.edu/*"
      ],
      "js": ["grades.js", "panel.js", "content.js"],
      "css": ["assets/themes/tokens.css", "content.css", "panel.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "*://ucam.uap-bd.edu/*"
  ],
  "commands": {
    "peek-reveal": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Reveal results"
    },
    "peek-hide": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Hide results"
    },
    "peek-toggle": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Toggle results visibility"
    }
  }
}
